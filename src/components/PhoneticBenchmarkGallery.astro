---
import type {
  BenchmarkGalleryCopy,
  BenchmarkStatus,
} from "../site/phonetic-benchmark";
import { getBenchmarkRunGroupRuns } from "../site/phonetic-benchmark";

interface Props {
  gallery: BenchmarkGalleryCopy;
}

const { gallery } = Astro.props;
const runGroups = gallery.resultGroups.map((group) => ({
  ...group,
  runs: getBenchmarkRunGroupRuns(gallery.runs, group.benchmarkVersion),
}));

function getStatusLabel(status: BenchmarkStatus): string {
  return gallery.statusLabels[status];
}
---

<article class="gallery">
  <header class="gallery-header">
    <p class="gallery-eyebrow ui-text">{gallery.eyebrow}</p>
    <h1>{gallery.title}</h1>
    {gallery.introParagraphs.map((paragraph) => <p>{paragraph}</p>)}
    <p class="gallery-report-link">
      <a href={gallery.reportHref}>{gallery.reportLabel}</a>
    </p>
  </header>

  <div class="gallery-groups">
    {
      runGroups.map((group) => (
        <section class="gallery-group">
          <h2>{group.heading}</h2>
          <p>{group.intro}</p>
          <ol class="gallery-list">
            {group.runs.map((run) => (
              <li class="gallery-item" data-run-id={run.id}>
                <figure>
                  <figcaption>
                    <h3>
                      <span class="gallery-order">
                        {run.benchmarkVersion}-{String(run.executionOrder).padStart(2, "0")}.
                      </span>{" "}
                      {run.model}
                      <span class="version-badge">
                        {gallery.versionLabels[run.benchmarkVersion]}
                      </span>
                    </h3>
                    <dl>
                      <div>
                        <dt>{gallery.detailLabels.status}</dt>
                        <dd>
                          <span class:list={["status", `status--${run.status}`]}>
                            {getStatusLabel(run.status)}
                          </span>
                        </dd>
                      </div>
                      <div>
                        <dt>{gallery.detailLabels.sourceLoc}</dt>
                        <dd>{run.sourceLoc.toLocaleString(gallery.lang)}</dd>
                      </div>
                      <div>
                        <dt>{gallery.detailLabels.testCount}</dt>
                        <dd>{run.testEvidence ?? String(run.testCount)}</dd>
                      </div>
                    </dl>
                    <a href={run.demoUrl}>{gallery.demoLabel}</a>
                  </figcaption>
                  <img
                    src={run.screenshotPath}
                    alt={run.screenshotAlt}
                    width="1440"
                    height="900"
                    loading="lazy"
                    decoding="async"
                  />
                </figure>
              </li>
            ))}
          </ol>
        </section>
      ))
    }
  </div>

  <p class="gallery-report-link">
    <a href={gallery.reportHref}>{gallery.reportLabel}</a>
  </p>
</article>

<style>
  .gallery > *,
  .gallery-header > *,
  .gallery-group > *,
  .gallery-item figure,
  .gallery-item h3,
  .gallery-item dl,
  .gallery-item dd {
    margin: 0;
  }

  .gallery-header > * + * {
    margin-top: calc(var(--spacing-rhythm) * 0.72);
  }

  .gallery-eyebrow {
    color: var(--accent);
    font-weight: 700;
    text-transform: uppercase;
  }

  .gallery-header p {
    max-width: 66ch;
  }

  .gallery-report-link {
    margin-top: calc(var(--spacing-rhythm) * 0.72);
  }

  .gallery-report-link a,
  .gallery-item a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-weight: 600;
  }

  .gallery-groups {
    margin: calc(var(--spacing-rhythm) * 1.45) 0 0;
  }

  .gallery-group + .gallery-group {
    margin-top: calc(var(--spacing-rhythm) * 1.45);
    padding-top: calc(var(--spacing-rhythm) * 1.45);
    border-top: 1px solid var(--divider);
  }

  .gallery-group > * + * {
    margin-top: calc(var(--spacing-rhythm) * 0.55);
  }

  .gallery-group h2 {
    max-width: 36ch;
    font-size: clamp(1.35rem, 1.24rem + 0.4vw, 1.65rem);
  }

  .gallery-list {
    margin: calc(var(--spacing-rhythm) * 0.7) 0 0;
    padding: 0;
    list-style: none;
  }

  .gallery-item + .gallery-item {
    margin-top: calc(var(--spacing-rhythm) * 1.45);
    padding-top: calc(var(--spacing-rhythm) * 1.45);
    border-top: 1px solid var(--divider);
  }

  .gallery-item img {
    width: 100%;
    height: auto;
    border: 1px solid var(--divider);
  }

  .gallery-item figcaption {
    margin-bottom: calc(var(--spacing-rhythm) * 0.48);
  }

  .gallery-item h3 {
    max-width: none;
    font-size: clamp(1.3rem, 1.18rem + 0.45vw, 1.62rem);
  }

  .gallery-order {
    color: var(--accent);
  }

  .version-badge {
    display: inline-flex;
    align-items: center;
    min-height: 1.35rem;
    margin-inline-start: 0.35rem;
    padding-inline: 0.38rem;
    border: 1px solid var(--divider);
    color: rgb(23 20 18 / 72%);
    font-family: var(--font-body);
    font-size: 0.62em;
    font-weight: 700;
    line-height: 1;
    text-transform: uppercase;
    vertical-align: middle;
  }

  .gallery-item dl {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.45rem 1rem;
    margin-top: calc(var(--spacing-rhythm) * 0.42);
    font-size: var(--text-ui);
    line-height: 1.38;
  }

  .gallery-item dt {
    color: rgb(23 20 18 / 72%);
    font-weight: 700;
  }

  .status {
    font-weight: 700;
  }

  .status--comparable {
    color: #25613d;
  }

  .status--contract-failing {
    color: #8a5618;
  }

  .status--unrunnable {
    color: #9a332d;
  }

  @media (max-width: 39.99rem) {
    .gallery-item dl {
      grid-template-columns: 1fr;
    }
  }
</style>
