---
import type { ConsultingCopy } from "../i18n/schema";

interface Props {
  copy: ConsultingCopy;
}

const { copy } = Astro.props;
const examplesHeadingId = "consulting-examples";
const clientValueHeadingId = "consulting-client-value";
const engagementHeadingId = "consulting-engagement";
const pricingDeliveryHeadingId = "consulting-pricing-delivery";
const collaborationHeadingId = "consulting-collaboration";
const aiHeadingId = "consulting-ai";
const fitHeadingId = "consulting-fit";
const evidenceHeadingId = "consulting-evidence";
const contactHeadingId = "consulting-contact";
---

<article class="consulting-page">
  <header class="consulting-header">
    <p class="consulting-eyebrow ui-text">{copy.eyebrow}</p>
    <h1>{copy.title}</h1>
    <p class="consulting-intro">{copy.intro}</p>
  </header>

  <section class="consulting-section" aria-labelledby={examplesHeadingId}>
    <h2 id={examplesHeadingId}>{copy.projectExamples.heading}</h2>
    <p>{copy.projectExamples.intro}</p>
    <div class="consulting-subsections">
      {
        copy.projectExamples.items.map((item) => (
          <div class="consulting-subsection">
            <h3>{item.heading}</h3>
            <p>{item.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="consulting-section" aria-labelledby={clientValueHeadingId}>
    <h2 id={clientValueHeadingId}>{copy.clientValue.heading}</h2>
    {copy.clientValue.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    <ul>
      {copy.clientValue.items.map((item) => <li>{item}</li>)}
    </ul>
    <p>{copy.clientValue.specialistBoundary}</p>
  </section>

  <section class="consulting-section" aria-labelledby={engagementHeadingId}>
    <h2 id={engagementHeadingId}>{copy.engagement.heading}</h2>
    <div class="consulting-subsections">
      {
        copy.engagement.steps.map((step) => (
          <div class="consulting-subsection">
            <h3>{step.heading}</h3>
            {step.paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
            {step.deliverables && (
              <ul>
                {step.deliverables.map((deliverable) => (
                  <li>{deliverable}</li>
                ))}
              </ul>
            )}
          </div>
        ))
      }
    </div>
  </section>

  <section
    class="consulting-section"
    aria-labelledby={pricingDeliveryHeadingId}
  >
    <h2 id={pricingDeliveryHeadingId}>{copy.pricingDelivery.heading}</h2>
    {copy.pricingDelivery.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
  </section>

  <section class="consulting-section" aria-labelledby={collaborationHeadingId}>
    <h2 id={collaborationHeadingId}>{copy.collaboration.heading}</h2>
    {copy.collaboration.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
  </section>

  <section class="consulting-section" aria-labelledby={aiHeadingId}>
    <h2 id={aiHeadingId}>{copy.ai.heading}</h2>
    {copy.ai.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
  </section>

  <section class="consulting-section" aria-labelledby={fitHeadingId}>
    <h2 id={fitHeadingId}>{copy.fit.goodHeading}</h2>
    <ul>
      {copy.fit.goodItems.map((item) => <li>{item}</li>)}
    </ul>
    <h2 class="fit-subheading">{copy.fit.notHeading}</h2>
    <ul>
      {copy.fit.notItems.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section class="consulting-section" aria-labelledby={evidenceHeadingId}>
    <h2 id={evidenceHeadingId}>{copy.evidence.heading}</h2>
    {copy.evidence.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    <p><a href={copy.evidence.href}>{copy.evidence.linkLabel}</a></p>
  </section>

  <section
    class="consulting-section consulting-contact"
    aria-labelledby={contactHeadingId}
  >
    <h2 id={contactHeadingId}>{copy.contact.heading}</h2>
    <p>{copy.contact.body}</p>
    <p>
      <a class="contact-email" href={`mailto:${copy.contact.email}`}>
        {copy.contact.email}
      </a>
    </p>
  </section>
</article>

<style>
  .consulting-page > * {
    margin: 0;
  }

  .consulting-page > * + * {
    margin-top: calc(var(--spacing-rhythm) * 1.45);
    padding-top: calc(var(--spacing-rhythm) * 1.45);
    border-top: 1px solid var(--divider);
  }

  .consulting-header > *,
  .consulting-section > * {
    margin: 0;
  }

  .consulting-header > * + *,
  .consulting-section > * + * {
    margin-top: calc(var(--spacing-rhythm) * 0.72);
  }

  .consulting-eyebrow {
    color: var(--accent);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .consulting-intro {
    margin-top: calc(var(--spacing-rhythm) * 0.9);
    font-size: clamp(1.125rem, 1.06rem + 0.28vw, 1.25rem);
    line-height: 1.5;
  }

  .consulting-header h1 {
    max-width: 16ch;
    font-size: clamp(2.35rem, 1.65rem + 3.5vw, 4.35rem);
  }

  .fit-subheading {
    margin-top: calc(var(--spacing-rhythm) * 1.05);
  }

  .consulting-subsections {
    margin-top: calc(var(--spacing-rhythm) * 0.95);
  }

  .consulting-subsection > * {
    margin: 0;
  }

  .consulting-subsection > * + * {
    margin-top: calc(var(--spacing-rhythm) * 0.42);
  }

  .consulting-subsection + .consulting-subsection {
    margin-top: calc(var(--spacing-rhythm) * 0.95);
  }

  .consulting-subsection h3 {
    max-width: 28ch;
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 1.12rem + 0.35vw, 1.45rem);
    font-weight: 600;
    line-height: 1.18;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .consulting-section ul {
    max-width: 62ch;
    margin-bottom: 0;
    padding-left: 1.25em;
  }

  .consulting-section li + li {
    margin-top: 0.4em;
  }

  .fit-subheading {
    font-size: clamp(1.35rem, 1.2rem + 0.72vw, 1.7rem);
  }

  .contact-email {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    font-weight: 600;
    overflow-wrap: anywhere;
  }
</style>
