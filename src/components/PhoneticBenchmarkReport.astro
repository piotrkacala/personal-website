---
import type {
  BenchmarkFailureType,
  BenchmarkReportCopy,
  BenchmarkRunCopy,
  BenchmarkStatus,
} from "../site/phonetic-benchmark";

interface Props {
  report: BenchmarkReportCopy;
}

const { report } = Astro.props;
const runs = [...report.runs].sort(
  (firstRun, secondRun) => firstRun.executionOrder - secondRun.executionOrder,
);
const statusOrder = [
  "comparable",
  "contract-failing",
  "unrunnable",
] as const satisfies readonly BenchmarkStatus[];
const benchmarkHeadingId = "benchmark-overview";
const readingHeadingId = "benchmark-reading";
const resultsHeadingId = "benchmark-results";
const findingsHeadingId = "benchmark-findings";
const caseNotesHeadingId = "benchmark-case-notes";
const artifactHeadingId = "benchmark-artifacts";
const closingHeadingId = "benchmark-closing";

function getRun(runId: string): BenchmarkRunCopy {
  const run = runs.find((candidate) => candidate.id === runId);

  if (!run) {
    throw new Error(`Missing benchmark run: ${runId}`);
  }

  return run;
}

function getStatusLabel(status: BenchmarkStatus): string {
  return report.statusLabels[status];
}

function getFailureTypeLabel(failureType: BenchmarkFailureType): string {
  return report.failureTypeLabels[failureType];
}

function getFailureTypes(run: BenchmarkRunCopy): string {
  return run.failureTypes.length > 0
    ? run.failureTypes.map(getFailureTypeLabel).join(", ")
    : report.noneLabel;
}
---

<article class="report">
  <header class="report-header">
    <p class="report-eyebrow ui-text">{report.eyebrow}</p>
    <h1>{report.title}</h1>
    <p class="report-summary">{report.summary}</p>
    <p class="report-home-link">
      <a href={report.homeHref}>{report.homeLabel}</a>
    </p>
  </header>

  <section class="report-section" aria-labelledby={benchmarkHeadingId}>
    <h2 id={benchmarkHeadingId}>{report.benchmarkHeading}</h2>
    {report.benchmarkParagraphs.map((paragraph) => <p>{paragraph}</p>)}
  </section>

  <section class="report-section" aria-labelledby={readingHeadingId}>
    <h2 id={readingHeadingId}>{report.readingHeading}</h2>
    <p>{report.readingIntro}</p>
    <ul class="status-list">
      {
        statusOrder.map((status) => (
          <li>
            <strong>{getStatusLabel(status)}:</strong>{" "}
            {report.statusDescriptions[status]}
          </li>
        ))
      }
    </ul>
    <p>{report.evidenceText}</p>
  </section>

  <section class="report-section" aria-labelledby={resultsHeadingId}>
    <h2 id={resultsHeadingId}>{report.resultsHeading}</h2>
    <p>{report.resultsIntro}</p>
    <p>
      {report.galleryText} <a href={report.galleryHref}>{report.galleryLabel}</a>
    </p>
    <div class="results-table-wrap">
      <table class="results-table">
        <thead>
          <tr>
            <th scope="col">{report.tableLabels.model}</th>
            <th scope="col">{report.tableLabels.status}</th>
            <th scope="col">{report.tableLabels.failureTypes}</th>
            <th scope="col">{report.tableLabels.sourceLoc}</th>
            <th scope="col">{report.tableLabels.testCount}</th>
            <th scope="col">{report.tableLabels.functionalRead}</th>
            <th scope="col">{report.tableLabels.demo}</th>
          </tr>
        </thead>
        <tbody>
          {
            runs.map((run) => (
              <tr
                data-status={run.status}
                data-run-date={run.runDate}
                data-stack={run.stack}
              >
                <th scope="row" data-label={report.tableLabels.model}>
                  {run.model}
                </th>
                <td data-label={report.tableLabels.status}>
                  <span class:list={["status", `status--${run.status}`]}>
                    {getStatusLabel(run.status)}
                  </span>
                </td>
                <td data-label={report.tableLabels.failureTypes}>
                  {getFailureTypes(run)}
                </td>
                <td data-label={report.tableLabels.sourceLoc}>
                  {run.sourceLoc.toLocaleString(report.lang)}
                </td>
                <td data-label={report.tableLabels.testCount}>
                  {run.testCount}
                </td>
                <td data-label={report.tableLabels.functionalRead}>
                  {run.functionalRead}
                </td>
                <td data-label={report.tableLabels.demo}>
                  <a href={run.demoUrl}>{report.demoLabel}</a>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <section class="report-section" aria-labelledby={findingsHeadingId}>
    <h2 id={findingsHeadingId}>{report.findingsHeading}</h2>
    <div class="narrative-list">
      {
        report.findings.map((finding) => (
          <section>
            <h3>{finding.heading}</h3>
            {finding.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </section>
        ))
      }
    </div>
  </section>

  <section class="report-section" aria-labelledby={caseNotesHeadingId}>
    <h2 id={caseNotesHeadingId}>{report.caseNotesHeading}</h2>
    <div class="case-note-list">
      {
        report.caseNotes.map((caseNote) => (
          <article class="case-note" id={`case-${caseNote.id}`}>
            <div class="case-note-copy">
              <h3>{caseNote.heading}</h3>
              {caseNote.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            </div>
            <div class="case-note-media">
              {caseNote.runIds.map((runId) => {
                const run = getRun(runId);

                return (
                  <figure class="case-screenshot">
                    <img
                      src={run.screenshotPath}
                      alt={run.screenshotAlt}
                      width="1440"
                      height="900"
                      loading="lazy"
                      decoding="async"
                    />
                    <figcaption>
                      <strong>{run.screenshotCaption}</strong>
                      <dl>
                        <div>
                          <dt>{report.detailLabels.runDate}</dt>
                          <dd>{run.runDate}</dd>
                        </div>
                        <div>
                          <dt>{report.detailLabels.stack}</dt>
                          <dd>{run.stack}</dd>
                        </div>
                      </dl>
                      <a href={run.demoUrl}>{report.demoLabel}</a>
                    </figcaption>
                  </figure>
                );
              })}
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="report-section" aria-labelledby={artifactHeadingId}>
    <h2 id={artifactHeadingId}>{report.artifactHeading}</h2>
    <p>{report.artifactIntro}</p>
    <p>
      {report.galleryText} <a href={report.galleryHref}>{report.galleryLabel}</a>
    </p>
    <ul class="artifact-list">
      {
        runs.map((run) => (
          <li>
            <a href={run.demoUrl}>{run.model}</a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="report-section" aria-labelledby={closingHeadingId}>
    <h2 id={closingHeadingId}>{report.closingHeading}</h2>
    <p>{report.closingText}</p>
  </section>
</article>

<style>
  .report > * {
    margin: 0;
  }

  .report > * + * {
    margin-top: calc(var(--spacing-rhythm) * 1.45);
    padding-top: calc(var(--spacing-rhythm) * 1.45);
    border-top: 1px solid var(--divider);
  }

  .report-header > *,
  .report-section > *,
  .narrative-list section > *,
  .case-note-copy > * {
    margin: 0;
  }

  .report-header > * + *,
  .report-section > * + *,
  .narrative-list section > * + *,
  .case-note-copy > * + * {
    margin-top: calc(var(--spacing-rhythm) * 0.72);
  }

  .report-eyebrow {
    color: var(--accent);
    font-weight: 700;
    text-transform: uppercase;
  }

  .report-summary {
    max-width: 66ch;
    font-size: clamp(1.12rem, 1.06rem + 0.2vw, 1.22rem);
    line-height: 1.5;
  }

  .report-home-link a,
  .case-screenshot a,
  .artifact-list a {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    font-weight: 600;
  }

  .status-list {
    max-width: 66ch;
    padding-inline-start: 1.3rem;
  }

  .status-list > li + li {
    margin-top: calc(var(--spacing-rhythm) * 0.28);
  }

  .results-table-wrap {
    width: 100%;
    overflow-x: auto;
    padding-bottom: 0.25rem;
  }

  .results-table {
    width: 100%;
    min-width: 68rem;
    border-collapse: collapse;
    font-size: var(--text-ui);
    line-height: 1.38;
  }

  .results-table th,
  .results-table td {
    padding: 0.62rem 0.68rem;
    text-align: start;
    vertical-align: top;
    border-bottom: 1px solid var(--divider);
  }

  .results-table thead th {
    color: rgb(23 20 18 / 72%);
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .results-table thead th:nth-child(1) {
    width: 12%;
  }

  .results-table thead th:nth-child(2) {
    width: 12%;
  }

  .results-table thead th:nth-child(3) {
    width: 15%;
  }

  .results-table thead th:nth-child(4),
  .results-table thead th:nth-child(5) {
    width: 8%;
  }

  .results-table thead th:nth-child(6) {
    width: 35%;
  }

  .results-table thead th:nth-child(7) {
    width: 10%;
  }

  .results-table tbody th {
    font-weight: 700;
  }

  .status {
    font-weight: 700;
  }

  .status--comparable {
    color: #25613d;
  }

  .status--contract-failing {
    color: #8a5618;
  }

  .status--unrunnable {
    color: #9a332d;
  }

  .narrative-list > section + section,
  .case-note-list > article + article {
    margin-top: calc(var(--spacing-rhythm) * 1.1);
    padding-top: calc(var(--spacing-rhythm) * 1.1);
    border-top: 1px solid rgb(23 20 18 / 10%);
  }

  .narrative-list h3,
  .case-note h3 {
    max-width: 36ch;
    font-family: var(--font-display);
    font-size: clamp(1.18rem, 1.1rem + 0.28vw, 1.35rem);
    line-height: 1.16;
  }

  .case-note-media {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr));
    gap: calc(var(--spacing-rhythm) * 0.82);
    margin-top: calc(var(--spacing-rhythm) * 0.72);
  }

  .case-screenshot {
    margin: 0;
  }

  .case-screenshot img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--divider);
  }

  .case-screenshot figcaption {
    display: grid;
    gap: 0.2rem;
    margin-top: calc(var(--spacing-rhythm) * 0.3);
    color: rgb(23 20 18 / 72%);
    font-size: var(--text-ui);
    line-height: 1.38;
  }

  .case-screenshot dl {
    margin: 0;
  }

  .case-screenshot dl > div {
    display: grid;
    grid-template-columns: minmax(0, 4.5rem) minmax(0, 1fr);
    gap: 0.35rem;
  }

  .case-screenshot dt {
    font-weight: 700;
  }

  .case-screenshot dd {
    margin: 0;
  }

  .artifact-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: 0.35rem 1.1rem;
    margin-inline: 0;
    padding-inline-start: 0;
    list-style: none;
  }

  @media (max-width: 39.99rem) {
    .results-table-wrap {
      overflow-x: visible;
      padding-bottom: 0;
    }

    .results-table,
    .results-table tbody,
    .results-table tr,
    .results-table th,
    .results-table td {
      display: block;
      width: 100%;
      min-width: 0;
    }

    .results-table thead {
      display: none;
    }

    .results-table tr {
      padding-block: calc(var(--spacing-rhythm) * 0.48);
      border-bottom: 1px solid var(--divider);
    }

    .results-table tbody th,
    .results-table td {
      display: grid;
      grid-template-columns: minmax(7rem, 38%) minmax(0, 1fr);
      gap: 0.45rem;
      padding: 0.28rem 0;
      border-bottom: 0;
    }

    .results-table tbody th::before,
    .results-table td::before {
      content: attr(data-label);
      color: rgb(23 20 18 / 72%);
      font-weight: 700;
      letter-spacing: 0.03em;
      text-transform: uppercase;
    }

    .case-screenshot dl > div {
      grid-template-columns: 1fr;
      gap: 0.05rem;
    }
  }
</style>
