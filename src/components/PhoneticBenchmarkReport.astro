---
import type {
  BenchmarkFailureType,
  BenchmarkReportCopy,
  BenchmarkRunCopy,
  BenchmarkStatus,
} from "../site/phonetic-benchmark";
import {
  getBenchmarkRunGroupRuns,
  phoneticBenchmarkMetadata,
} from "../site/phonetic-benchmark";

interface Props {
  report: BenchmarkReportCopy;
}

const { report } = Astro.props;
const allRuns = [...report.runs].sort(
  (firstRun, secondRun) => firstRun.executionOrder - secondRun.executionOrder,
);
const statusOrder = [
  "comparable",
  "contract-failing",
  "unrunnable",
] as const satisfies readonly BenchmarkStatus[];
const currentBenchmarkVersion = phoneticBenchmarkMetadata.currentBenchmarkVersion;
const currentRuns = getBenchmarkRunGroupRuns(
  report.runs,
  currentBenchmarkVersion,
);
const currentComparableRuns = currentRuns.filter(
  (run) => run.status === "comparable",
);
const benchmarkHeadingId = "benchmark-overview";
const readingHeadingId = "benchmark-reading";
const spotlightHeadingId = "benchmark-spotlights";
const resultsHeadingId = "benchmark-results";
const findingsHeadingId = "benchmark-findings";
const caseNotesHeadingId = "benchmark-case-notes";
const artifactHeadingId = "benchmark-artifacts";
const closingHeadingId = "benchmark-closing";
const currentSummaryHeadingId = "current-v2-summary";

function getStatusRank(status: BenchmarkStatus): number {
  return statusOrder.indexOf(status);
}

const runGroups = report.resultGroups.map((group) => ({
  ...group,
  isHistorical: group.benchmarkVersion !== currentBenchmarkVersion,
  runs: getBenchmarkRunGroupRuns(report.runs, group.benchmarkVersion).toSorted(
    (firstRun, secondRun) =>
      getStatusRank(firstRun.status) - getStatusRank(secondRun.status) ||
      firstRun.executionOrder - secondRun.executionOrder,
  ),
}));

function getRun(runId: string): BenchmarkRunCopy {
  const run = allRuns.find((candidate) => candidate.id === runId);

  if (!run) {
    throw new Error(`Missing benchmark run: ${runId}`);
  }

  return run;
}

function getStatusLabel(status: BenchmarkStatus): string {
  return report.statusLabels[status];
}

function getFailureTypeLabel(failureType: BenchmarkFailureType): string {
  return report.failureTypeLabels[failureType];
}

function getFailureTypes(run: BenchmarkRunCopy): string {
  return run.failureTypes.length > 0
    ? run.failureTypes.map(getFailureTypeLabel).join(", ")
    : report.noneLabel;
}

function getResultEvidenceId(run: BenchmarkRunCopy): string {
  return `evidence-${run.id}`;
}

function getCurrentStatusCount(status: BenchmarkStatus): number {
  return currentRuns.filter((run) => run.status === status).length;
}
---

<article class="report">
  <header class="report-header">
    <p class="report-eyebrow ui-text">{report.eyebrow}</p>
    <h1>{report.title}</h1>
    <p class="report-summary">{report.summary}</p>
    <div class="current-summary" aria-labelledby={currentSummaryHeadingId}>
      <div>
        <p class="current-summary-kicker ui-text">
          {report.currentSummaryKicker}
        </p>
        <h2 id={currentSummaryHeadingId}>{report.currentSummaryHeading}</h2>
        <p>{report.currentSummaryText}</p>
      </div>
      <dl class="current-summary-stats">
        {
          statusOrder.map((status) => (
            <div>
              <dt>{getStatusLabel(status)}</dt>
              <dd>{getCurrentStatusCount(status)}</dd>
            </div>
          ))
        }
      </dl>
      <div>
        <p class="current-summary-label ui-text">
          {report.currentSummaryComparableLabel}
        </p>
        <ul class="run-chip-list" aria-label={report.currentSummaryComparableLabel}>
          {
            currentComparableRuns.map((run) => (
              <li>
                <a href={run.detailsUrl}>{run.model}</a>
              </li>
            ))
          }
        </ul>
      </div>
      <p class="current-summary-links">
        <a href={`#${resultsHeadingId}`}>{report.currentSummaryResultsLabel}</a>
        <a href={report.galleryHref}>{report.currentSummaryGalleryLabel}</a>
      </p>
    </div>
    <p class="report-metadata ui-text">
      <span
        >{report.metadataLabels.benchmark}
        {phoneticBenchmarkMetadata.coveredBenchmarkVersions.join("-")}</span
      >
      <span aria-hidden="true">&middot;</span>
      <span>{report.runs.length} {report.metadataLabels.runs}</span>
      <span aria-hidden="true">&middot;</span>
      <span>
        {report.metadataLabels.updated}: <time
          datetime={phoneticBenchmarkMetadata.updatedDate}
        >
          {phoneticBenchmarkMetadata.updatedDate}
        </time>
      </span>
      <span aria-hidden="true">&middot;</span>
      <a href={report.methodologyHref}>{report.methodologyLabel}</a>
    </p>
    <p class="report-home-link">
      <a href={report.homeHref}>{report.homeLabel}</a>
    </p>
  </header>

  <section class="report-section" aria-labelledby={benchmarkHeadingId}>
    <h2 id={benchmarkHeadingId}>{report.benchmarkHeading}</h2>
    {report.benchmarkParagraphs.map((paragraph) => <p>{paragraph}</p>)}
  </section>

  <section class="report-section" aria-labelledby={readingHeadingId}>
    <h2 id={readingHeadingId}>{report.readingHeading}</h2>
    <p>{report.readingIntro}</p>
    <ul class="status-list">
      {
        statusOrder.map((status) => (
          <li>
            <strong>{getStatusLabel(status)}:</strong>{" "}
            {report.statusDescriptions[status]}
          </li>
        ))
      }
    </ul>
    <p>{report.evidenceText}</p>
  </section>

  <section class="report-section" aria-labelledby={spotlightHeadingId}>
    <h2 id={spotlightHeadingId}>{report.spotlightHeading}</h2>
    <p>{report.spotlightIntro}</p>
    <div class="spotlight-list">
      {
        report.spotlights.map((spotlight) => (
          <article class="spotlight" id={`spotlight-${spotlight.id}`}>
            <div class="spotlight-copy">
              <h3>{spotlight.heading}</h3>
              {spotlight.paragraphs.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </div>
            <ul class="run-chip-list" aria-label={spotlight.heading}>
              {spotlight.runIds.map((runId) => {
                const run = getRun(runId);

                return (
                  <li>
                    <a href={run.detailsUrl}>{run.model}</a>
                  </li>
                );
              })}
            </ul>
          </article>
        ))
      }
    </div>
  </section>

  <section class="report-section" aria-labelledby={resultsHeadingId}>
    <h2 id={resultsHeadingId}>{report.resultsHeading}</h2>
    <p>{report.resultsIntro}</p>
    <p>
      {report.galleryText}
      <a href={report.galleryHref}>{report.galleryLabel}</a>
    </p>
    {
      runGroups.map((group) => (
        <details class="results-group" open={!group.isHistorical}>
          <summary>
            <h3>{group.heading}</h3>
          </summary>
          <p>{group.intro}</p>
          <ol class="result-card-list">
            {group.runs.map((run) => (
              <li>
                <article
                  class="result-card"
                  data-status={run.status}
                  data-benchmark-version={run.benchmarkVersion}
                  data-run-date={run.runDate}
                  data-stack={run.stack}
                >
                  <div class="result-card-main">
                    <div class="result-card-heading">
                      <h4>{run.model}</h4>
                      <span class:list={["status", `status--${run.status}`]}>
                        {getStatusLabel(run.status)}
                      </span>
                    </div>
                    <p>{run.functionalRead}</p>
                  </div>
                  <a
                    class="result-screenshot"
                    href={run.detailsUrl}
                    aria-label={`${report.detailLabels.screenshot}: ${run.model}`}
                  >
                    <img
                      src={run.screenshotPath}
                      alt={run.screenshotAlt}
                      width="1440"
                      height="900"
                      loading="lazy"
                      decoding="async"
                    />
                  </a>
                  <dl class="result-meta">
                    <div>
                      <dt>{report.tableLabels.failureTypes}</dt>
                      <dd>{getFailureTypes(run)}</dd>
                    </div>
                    <div>
                      <dt>{report.detailLabels.runDate}</dt>
                      <dd>{run.runDate}</dd>
                    </div>
                    {run.comparativeScore !== undefined && (
                      <div>
                        <dt>{report.detailLabels.comparativeScore}</dt>
                        <dd>{run.comparativeScore}</dd>
                      </div>
                    )}
                  </dl>
                  <details
                    class="result-evidence"
                    id={getResultEvidenceId(run)}
                  >
                    <summary>{report.tableLabels.evidenceDetails}</summary>
                    <dl>
                      <div>
                        <dt>{report.tableLabels.sourceLoc}</dt>
                        <dd>{run.sourceLoc.toLocaleString(report.lang)}</dd>
                      </div>
                      <div>
                        <dt>{report.tableLabels.testCount}</dt>
                        <dd>{run.testEvidence ?? String(run.testCount)}</dd>
                      </div>
                      <div>
                        <dt>{report.detailLabels.stack}</dt>
                        <dd>{run.stack}</dd>
                      </div>
                    </dl>
                  </details>
                  <p class="result-links">
                    <a href={run.detailsUrl}>{report.detailsLabel}</a>
                    <a href={run.demoUrl}>{report.demoLabel}</a>
                  </p>
                </article>
              </li>
            ))}
          </ol>
        </details>
      ))
    }
  </section>

  <section class="report-section" aria-labelledby={caseNotesHeadingId}>
    <h2 id={caseNotesHeadingId}>{report.caseNotesHeading}</h2>
    <div class="case-note-list">
      {
        report.caseNotes.map((caseNote) => (
          <article class="case-note" id={`case-${caseNote.id}`}>
            <div class="case-note-copy">
              <h3>{caseNote.heading}</h3>
              {caseNote.paragraphs.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </div>
            {
              !(caseNote.runIds.length > 3) && (
                <div class="case-note-media">
                  {caseNote.runIds.map((runId) => {
                    const run = getRun(runId);

                    return (
                      <figure class="case-screenshot">
                        <img
                          src={run.screenshotPath}
                          alt={run.screenshotAlt}
                          width="1440"
                          height="900"
                          loading="lazy"
                          decoding="async"
                        />
                        <figcaption>
                          <strong>{run.screenshotCaption}</strong>
                          <dl>
                            <div>
                              <dt>{report.detailLabels.runDate}</dt>
                              <dd>{run.runDate}</dd>
                            </div>
                            <div>
                              <dt>{report.detailLabels.stack}</dt>
                              <dd>{run.stack}</dd>
                            </div>
                          </dl>
                          <a href={run.demoUrl}>{report.demoLabel}</a>
                        </figcaption>
                      </figure>
                    );
                  })}
                </div>
              )
            }
          </article>
        ))
      }
    </div>
  </section>

  <section class="report-section" aria-labelledby={findingsHeadingId}>
    <h2 id={findingsHeadingId}>{report.findingsHeading}</h2>
    <div class="narrative-list">
      {
        report.findings.map((finding) => (
          <section>
            <h3>{finding.heading}</h3>
            {finding.paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </section>
        ))
      }
    </div>
  </section>

  <section class="report-section" aria-labelledby={artifactHeadingId}>
    <h2 id={artifactHeadingId}>{report.artifactHeading}</h2>
    <p>{report.artifactIntro}</p>
    <p>
      {report.galleryText}
      <a href={report.galleryHref}>{report.galleryLabel}</a>
    </p>
    <p>
      {report.metadataLabels.machineReadable}: {
        report.resourceLinks.map((resource, index) => (
          <>
            {index > 0 && <span aria-hidden="true"> / </span>}
            <a href={resource.href}>{resource.label}</a>
          </>
        ))
      }
    </p>
    <ul class="artifact-list">
      {
        runGroups.map((group) => (
          <li>
            <strong>{group.heading}</strong>
            <ul>
              {group.runs.map((run) => (
                <li>
                  <a href={run.demoUrl}>{run.model}</a>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="report-section" aria-labelledby={closingHeadingId}>
    <h2 id={closingHeadingId}>{report.closingHeading}</h2>
    <p>{report.closingText}</p>
  </section>
</article>

<style>
  .report > * {
    margin: 0;
  }

  .report > * + * {
    margin-top: calc(var(--spacing-rhythm) * 1.45);
    padding-top: calc(var(--spacing-rhythm) * 1.45);
    border-top: 1px solid var(--divider);
  }

  .report-header > *,
  .current-summary > *,
  .current-summary > div > *,
  .report-section > *,
  .narrative-list section > *,
  .case-note-copy > * {
    margin: 0;
  }

  .report-header > * + *,
  .current-summary > * + *,
  .current-summary > div > * + *,
  .report-section > * + *,
  .narrative-list section > * + *,
  .case-note-copy > * + * {
    margin-top: calc(var(--spacing-rhythm) * 0.72);
  }

  .report-eyebrow {
    color: var(--accent);
    font-weight: 700;
    text-transform: uppercase;
  }

  .report-summary {
    max-width: 66ch;
    font-size: clamp(1.12rem, 1.06rem + 0.2vw, 1.22rem);
    line-height: 1.5;
  }

  .current-summary {
    display: grid;
    max-width: 58rem;
    padding: calc(var(--spacing-rhythm) * 0.72);
    border: 1px solid var(--divider);
    border-radius: 0.35rem;
    gap: calc(var(--spacing-rhythm) * 0.58);
  }

  .current-summary-kicker,
  .current-summary-label {
    color: var(--accent);
    font-weight: 700;
    text-transform: uppercase;
  }

  .current-summary h2 {
    max-width: 22ch;
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 1.18rem + 0.42vw, 1.62rem);
    line-height: 1.14;
  }

  .current-summary-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.45rem;
    margin: 0;
  }

  .current-summary-stats div {
    padding-block: 0.5rem;
    border-block: 1px solid rgb(23 20 18 / 10%);
  }

  .current-summary-stats dt {
    color: rgb(23 20 18 / 72%);
    font-size: var(--text-ui);
    font-weight: 700;
  }

  .current-summary-stats dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 1.56rem + 0.8vw, 2.42rem);
    line-height: 1;
  }

  .current-summary-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.32rem 0.82rem;
    align-items: center;
  }

  .report-home-link a,
  .current-summary-links a,
  .case-screenshot a,
  .artifact-list a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-weight: 600;
  }

  .status-list {
    max-width: 66ch;
    padding-inline-start: 1.3rem;
  }

  .status-list > li + li {
    margin-top: calc(var(--spacing-rhythm) * 0.28);
  }

  .results-group {
    margin-top: calc(var(--spacing-rhythm) * 0.95);
  }

  .results-group > * {
    margin: 0;
  }

  .results-group > * + * {
    margin-top: calc(var(--spacing-rhythm) * 0.45);
  }

  .results-group > summary {
    min-height: 2.75rem;
    cursor: pointer;
  }

  .results-group > summary::marker {
    color: var(--accent);
  }

  .results-group h3 {
    display: inline;
    max-width: 36ch;
    font-family: var(--font-display);
    font-size: clamp(1.18rem, 1.1rem + 0.28vw, 1.35rem);
    line-height: 1.16;
  }

  .spotlight-list,
  .result-card-list {
    display: grid;
    gap: calc(var(--spacing-rhythm) * 0.62);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .spotlight,
  .result-card {
    border: 1px solid var(--divider);
    border-radius: 0.35rem;
    padding: calc(var(--spacing-rhythm) * 0.68);
  }

  .spotlight {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(12rem, 28%);
    gap: calc(var(--spacing-rhythm) * 0.72);
    align-items: start;
  }

  .spotlight-copy > *,
  .result-card > *,
  .result-card-main > * {
    margin: 0;
  }

  .spotlight-copy > * + *,
  .result-card > * + *,
  .result-card-main > * + * {
    margin-top: calc(var(--spacing-rhythm) * 0.38);
  }

  .spotlight h3,
  .result-card h4 {
    font-family: var(--font-display);
    line-height: 1.16;
  }

  .spotlight h3 {
    max-width: 34ch;
    font-size: clamp(1.12rem, 1.06rem + 0.22vw, 1.25rem);
  }

  .run-chip-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.32rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .run-chip-list a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: 0.54rem;
    border: 1px solid var(--divider);
    border-radius: 999px;
    font-size: var(--text-ui);
    font-weight: 700;
    text-decoration: none;
  }

  .run-chip-list a:hover {
    text-decoration: underline;
  }

  .result-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(13rem, 24%);
    gap: calc(var(--spacing-rhythm) * 0.52) calc(var(--spacing-rhythm) * 0.72);
    font-size: var(--text-ui);
    line-height: 1.4;
  }

  .result-card-main {
    min-width: 0;
  }

  .result-card-heading {
    display: flex;
    flex-wrap: wrap;
    gap: 0.34rem 0.58rem;
    align-items: baseline;
  }

  .result-card h4 {
    margin: 0;
    font-size: clamp(1.04rem, 1rem + 0.16vw, 1.14rem);
  }

  .status {
    font-weight: 700;
  }

  .status--comparable {
    color: #25613d;
  }

  .status--contract-failing {
    color: #8a5618;
  }

  .status--unrunnable {
    color: #9a332d;
  }

  .result-meta,
  .result-evidence dl,
  .case-screenshot dl {
    margin: 0;
  }

  .result-meta,
  .result-evidence dl {
    display: grid;
    gap: 0.28rem;
  }

  .result-meta {
    grid-column: 1 / -1;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    padding-top: calc(var(--spacing-rhythm) * 0.34);
    border-top: 1px solid rgb(23 20 18 / 10%);
  }

  .result-meta > div,
  .result-evidence dl > div {
    display: grid;
    grid-template-columns: minmax(6rem, 34%) minmax(0, 1fr);
    gap: 0.42rem;
  }

  .result-meta dt,
  .result-evidence dt {
    color: rgb(23 20 18 / 72%);
    font-weight: 700;
  }

  .result-meta dd,
  .result-evidence dd {
    margin: 0;
  }

  .result-evidence {
    grid-column: 1 / -1;
    padding-top: calc(var(--spacing-rhythm) * 0.34);
    border-top: 1px solid rgb(23 20 18 / 10%);
  }

  .result-evidence summary {
    min-height: 2.75rem;
    color: rgb(23 20 18 / 72%);
    cursor: pointer;
    font-weight: 700;
  }

  .result-screenshot {
    display: block;
    align-self: start;
  }

  .result-screenshot img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--divider);
  }

  .result-links {
    display: flex;
    flex-wrap: wrap;
    grid-column: 1 / -1;
    gap: 0.32rem 0.82rem;
    align-items: center;
  }

  .result-links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-weight: 700;
  }

  .narrative-list > section + section,
  .case-note-list > article + article {
    margin-top: calc(var(--spacing-rhythm) * 1.1);
    padding-top: calc(var(--spacing-rhythm) * 1.1);
    border-top: 1px solid rgb(23 20 18 / 10%);
  }

  .narrative-list h3,
  .case-note h3 {
    max-width: 36ch;
    font-family: var(--font-display);
    font-size: clamp(1.18rem, 1.1rem + 0.28vw, 1.35rem);
    line-height: 1.16;
  }

  .case-note-media {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr));
    gap: calc(var(--spacing-rhythm) * 0.82);
    margin-top: calc(var(--spacing-rhythm) * 0.72);
  }

  .case-screenshot {
    margin: 0;
  }

  .case-screenshot img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--divider);
  }

  .case-screenshot figcaption {
    display: grid;
    gap: 0.2rem;
    margin-top: calc(var(--spacing-rhythm) * 0.3);
    color: rgb(23 20 18 / 72%);
    font-size: var(--text-ui);
    line-height: 1.38;
  }

  .case-screenshot dl > div {
    display: grid;
    grid-template-columns: minmax(0, 4.5rem) minmax(0, 1fr);
    gap: 0.35rem;
  }

  .case-screenshot dt {
    font-weight: 700;
  }

  .case-screenshot dd {
    margin: 0;
  }

  .artifact-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: 0.35rem 1.1rem;
    margin-inline: 0;
    padding-inline-start: 0;
    list-style: none;
  }

  .artifact-list ul {
    margin: calc(var(--spacing-rhythm) * 0.24) 0 0;
    padding-inline-start: 1.1rem;
  }

  @media (max-width: 52rem) {
    .spotlight,
    .result-card {
      grid-template-columns: 1fr;
    }

    .current-summary-stats,
    .result-meta {
      grid-template-columns: 1fr;
    }

    .result-meta > div,
    .result-evidence dl > div {
      grid-template-columns: 1fr;
      gap: 0.05rem;
    }
  }

  @media (max-width: 39.99rem) {
    .case-screenshot dl > div {
      grid-template-columns: 1fr;
      gap: 0.05rem;
    }
  }
</style>
