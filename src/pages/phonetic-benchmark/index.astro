---
import PhoneticBenchmarkReport from "../../components/PhoneticBenchmarkReport.astro";
import Base from "../../layouts/Base.astro";
import {
  getPhoneticBenchmarkMarkdownUrl,
  phoneticBenchmarkReports,
} from "../../site/phonetic-benchmark";

const report = phoneticBenchmarkReports.en;
const alternates = {
  en: report.metadata.openGraph.url,
  pl: phoneticBenchmarkReports.pl.metadata.openGraph.url,
  default: report.metadata.openGraph.url,
};
---

<Base
  lang={report.lang}
  metadata={report.metadata}
  languageSwitcher={report.languageSwitcher}
  markdownUrl={getPhoneticBenchmarkMarkdownUrl(report.lang)}
  alternates={alternates}
  homeLink={{ href: report.homeHref, ariaLabel: report.homeLabel }}
  contentWidth="wide"
>
  <PhoneticBenchmarkReport report={report} />
</Base>
